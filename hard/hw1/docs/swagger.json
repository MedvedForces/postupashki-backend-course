            "post": {
                "description": "Отправить таску на обработку",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Таска"
                ],
                "summary": "Отправить таску на обработку",
                "parameters": [
                    {
                        "description": "Таска которую нужно решить в string формате",
                        "name": "task_body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "type": "string",
                        "description": "Bearer {auth_token}",
                        "name": "Authorization",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
